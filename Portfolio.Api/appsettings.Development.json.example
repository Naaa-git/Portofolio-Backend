{
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5433;Database=portofolio;Username=postgres;Password=postgres"
  },
  "Jwt": {
    "SigningKey": "replace-with-a-random-string-at-least-32-characters-long"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000" ]
  },
  "Google": {
    "ClientId": "replace-with-your-oauth-client-id.apps.googleusercontent.com"
  },
  "Microsoft": {
    "ClientId": "replace-with-your-azure-app-registration-client-id"
  },
  "Brevo": {
    "ApiKey": "replace-with-your-brevo-api-key",
    "SenderEmail": "replace-with-your-verified-sender-email",
    "SenderName": "Portfolio Admin"
  }
}
