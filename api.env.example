# Written automatically by the backend CD workflow on every deploy — don't
# hand-edit the real api.env on the VPS, it gets overwritten next release.

ConnectionStrings__Default=Host=postgres;Port=5432;Database=portofolio;Username=postgres;Password=
Jwt__SigningKey=
Jwt__Issuer=portofolio-api
Jwt__Audience=portofolio-admin
Google__ClientId=
Microsoft__ClientId=
Brevo__ApiKey=
Brevo__SenderEmail=
Brevo__SenderName=Portfolio Admin
SeedAdmin__Username=
SeedAdmin__Password=
SeedAdmin__Email=
OpenSearch__Url=http://opensearch:9200
Kafka__BootstrapServers=kafka:9092
Kafka__OtpEmailTopic=send-otp-email
Cors__AllowedOrigins__0=
Loki__Url=http://loki:3100
